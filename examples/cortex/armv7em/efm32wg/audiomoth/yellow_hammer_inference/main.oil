OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {

    /* This fix the default STACKSIZE of tasks */
    TASK {
        UINT32 STACKSIZE = 18000 ;
    } ;

    /* This fix the default STACKSIZE of ISRs */
    ISR {
        UINT32 STACKSIZE = 200 ;
    } ;
};

CPU blink {
  OS config {
    STATUS = EXTENDED;
    PAINT_STACK = TRUE;
    PAINT_REGISTERS = TRUE;

    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../../../..";
      APP_CPPSRC = "main.cpp";
      APP_CPPSRC = "model/bands_int8_model_model_data.cc";
      APP_NAME = "main_exe";
      LIBRARY = cmsisdsp;
      LIBRARY = cmsisnn;
      LIBRARY = tflite;
      CFLAGS  = "-Og -g -DEFM32WG380F256=1";
      CPPFLAGS = "-Og -g -DEFM32WG380F256=1";
      CPPFLAGS = "-std=c++17";
      CPPFLAGS = "-DTF_LITE_STATIC_MEMORY -DTF_LITE_DISABLE_X86_NEON -DNDEBUG";
      CPPFLAGS = "-DCMSIS_NN -DKERNELS_OPTIMIZED_FOR_SPEED";
      CPPFLAGS = "-DTF_LITE_MCU_DEBUG_LOG -DTF_LITE_STRIP_ERROR_STRINGS";
      CPPFLAGS = "-mfpu=auto";
      CPPFLAGS = "-Wnon-virtual-dtor";
      CPPFLAGS = "-fno-unwind-tables";
      CPPFLAGS = "-fno-use-cxa-atexit";
      CPPFLAGS = "-fno-asynchronous-unwind-tables";
      CPPFLAGS = "-Wsign-compare -Wdouble-promotion -Wunused-variable -Wunused-function -Wswitch -Wvla -Wall -Wextra -Wmissing-field-initializers -Wstrict-aliasing -Wno-unused-parameter"; 
      CPPFLAGS = "-mlittle-endian -Wno-type-limits -Wno-unused-private-field -fomit-frame-pointer";
      CPPFLAGS  = "-I/Users/bernabeu-a/bin/tflite-micro";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tools/make/downloads/flatbuffers/include";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tools/make/downloads/gemmlowp";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/c";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/core";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/core/api";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/core/c";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/kernels";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/kernels/internal";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/kernels/internal/reference";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/compiler/mlir/lite/kernels/internal";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/compiler/mlir/lite/core/api";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/compiler/mlir/lite/core/c";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/compiler/mlir/lite/schema";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/kernels";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/arena_allocator";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/memory_planner";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tflite_bridge";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tools/make";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/make/downloads";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tools/make/downloads/kissfft";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/tensorflow/lite/micro/tools/make/downloads/ruy/";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/signal/src/kiss_fft_wrappers/";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/signal/micro/kernels";
      CPPFLAGS = "-I/Users/bernabeu-a/bin/tflite-micro/signal/src";
      LDFLAGS = "-Map=main.map";
      LDFLAGS = "--print-memory-usage";
      LDFLAGS = "-nostdlib";
      LDFLAGS = "-L/Applications/ARM/arm-none-eabi/lib/thumb/v7e-m+fp/hard";
      COMPILER = "arm-none-eabi-gcc";
      CPPCOMPILER = "arm-none-eabi-g++";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = CMAKE {VSCODE=TRUE;};
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE Std {};

  TASK inference {
    PRIORITY = 1;
    AUTOSTART = TRUE {APPMODE=Std;};
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };
};
