OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {

    /* This fix the default STACKSIZE of tasks */
    TASK {
        UINT32 STACKSIZE = 400 ;
    } ;

    /* This fix the default STACKSIZE of ISRs */
    ISR {
        UINT32 STACKSIZE = 200 ;
    } ;
};

CPU blink {
  OS config {
    STATUS = EXTENDED;
    PAINT_STACK = TRUE;
    PAINT_REGISTERS = TRUE;

    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../../../..";
      APP_SRC = "main.c";
      APP_NAME = "main_exe";
      LIBRARY = dmactrl;
      LIBRARY = microsd;
      LIBRARY = cmsisdsp;
      // LIBRARY = cmsisnn;
      CFLAGS  = "-Og -g -DEFM32WG380F256=1";
      // Linker flags
      LDFLAGS = "-Map=main.map";
      LDFLAGS = "--print-memory-usage";
      COMPILER = "arm-none-eabi-gcc";
      CPPCOMPILER = "arm-none-eabi-g++";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = CMAKE {VSCODE=TRUE;};
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE Std {};

  TASK start_sdcard {
    PRIORITY = 5;
    AUTOSTART = TRUE {APPMODE = Std;};
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  TASK start_audio {
    PRIORITY = 2;
    AUTOSTART = TRUE {APPMODE = Std;};
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  TASK start_dma {
    PRIORITY = 2;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };
  
  TASK normalize {
    PRIORITY = 4;
    AUTOSTART = TRUE {APPMODE = Std;};
    // AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
    EVENT = ev_NORMALIZE;
  };

  EVENT ev_NORMALIZE {
    MASK = AUTO;
  };

  EVENT ev_DMAtoSRAM {
    MASK = AUTO;
  };

  TASK copyDMAtoSRAM {
    PRIORITY = 3;
    AUTOSTART = TRUE {APPMODE = Std;};
    ACTIVATION = 1;
    SCHEDULE = FULL;
    EVENT = ev_DMAtoSRAM;
  };

  TASK blink {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  ALARM blink_blink {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK {
      TASK = blink;
    };
    AUTOSTART = TRUE {
      APPMODE = Std;
      ALARMTIME = 100;
      CYCLETIME = 100;
    };
  };

  // ISR isr_adc {
  //   CATEGORY = 1;
  //   PRIORITY = 1;
  //   SOURCE = ADC0_IRQ;
  // };

  ISR isr_dma {
    CATEGORY = 2;
    PRIORITY = 1;
    SOURCE = DMA_IRQ;
  };
};
